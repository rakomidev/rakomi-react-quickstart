# Copy to .env.local — it is gitignored.
# RakomiProvider auto-detects both of these — see src/main.tsx.

# The OAuth client_id for a Rakomi PUBLIC client (no client_secret — PKCE is the proof).
VITE_RAKOMI_CLIENT_ID=

# Optional — defaults to https://api.rakomi.com when unset.
# VITE_RAKOMI_BASE_URL=https://api.rakomi.com
